<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!--
        Build a link/joint name prefix from a side name and a serial number, and expose
        it to the caller as 'computed_prefix'.

        Mirrors compute_arm_prefix in flexiv_description's flexiv_common.xacro and must
        stay in step with it: the separating underscore only appears when the part it
        separates is non-empty. Concatenating unconditionally yields 'left__base_link'
        for an empty robot_sn where the URDF creates 'left_base_link'.

        side:     'left', 'right' or '' (no trailing underscore)
        robot_sn: robot serial number, may be empty
    -->
    <xacro:macro name="compute_prefix" params="side:='' robot_sn:=''">
        <xacro:property name="computed_prefix"
            value="${(side + '_' + robot_sn + '_') if side != '' and robot_sn != '' else (side + robot_sn + '_') if (side + robot_sn) != '' else ''}"
            scope="parent" />
    </xacro:macro>

    <!-- 'prefix' is the fully-formed prefix, normally from compute_prefix above. -->
    <xacro:macro name="rizon_srdf" params="prefix load_mounted_ft_sensor use_virtual_joint:=true">

        <group name="${prefix}arm">
            <chain base_link="${prefix}base_link" tip_link="${prefix}flange" />
        </group>

        <group_state name="${prefix}home" group="${prefix}arm">
            <joint name="${prefix}joint1" value="0" />
            <joint name="${prefix}joint2" value="${-2*pi/9}" />
            <joint name="${prefix}joint3" value="0" />
            <joint name="${prefix}joint4" value="${pi/2}" />
            <joint name="${prefix}joint5" value="0" />
            <joint name="${prefix}joint6" value="${2*pi/9}" />
            <joint name="${prefix}joint7" value="0" />
        </group_state>

        <xacro:if value="${use_virtual_joint}">
            <virtual_joint name="virtual_joint" type="fixed" parent_frame="world"
                child_link="${prefix}base_link" />
        </xacro:if>

        <disable_collisions link1="${prefix}base_link" link2="${prefix}link1" reason="Adjacent" />
        <disable_collisions link1="${prefix}base_link" link2="${prefix}link2" reason="Never" />
        <disable_collisions link1="${prefix}base_link" link2="${prefix}link3" reason="Never" />
        <disable_collisions link1="${prefix}base_link" link2="${prefix}link4" reason="Never" />
        <disable_collisions link1="${prefix}link1" link2="${prefix}link2" reason="Adjacent" />
        <disable_collisions link1="${prefix}link1" link2="${prefix}link3" reason="Never" />
        <disable_collisions link1="${prefix}link1" link2="${prefix}link4" reason="Never" />
        <disable_collisions link1="${prefix}link2" link2="${prefix}link3" reason="Adjacent" />
        <disable_collisions link1="${prefix}link2" link2="${prefix}link4" reason="Never" />
        <disable_collisions link1="${prefix}link2" link2="${prefix}link5" reason="Never" />
        <disable_collisions link1="${prefix}link3" link2="${prefix}link4" reason="Adjacent" />
        <disable_collisions link1="${prefix}link3" link2="${prefix}link5" reason="Never" />
        <disable_collisions link1="${prefix}link3" link2="${prefix}link6" reason="Never" />
        <disable_collisions link1="${prefix}link3" link2="${prefix}link7" reason="Never" />
        <disable_collisions link1="${prefix}link4" link2="${prefix}link5" reason="Adjacent" />
        <disable_collisions link1="${prefix}link4" link2="${prefix}link6" reason="Never" />
        <disable_collisions link1="${prefix}link4" link2="${prefix}link7" reason="Never" />
        <disable_collisions link1="${prefix}link5" link2="${prefix}link6" reason="Adjacent" />
        <disable_collisions link1="${prefix}link6" link2="${prefix}link7" reason="Adjacent" />
        <disable_collisions link1="${prefix}link7" link2="${prefix}flange" reason="Adjacent" />

        <xacro:if value="${load_mounted_ft_sensor}">
            <!-- Disable collisions for FT sensor fixed-link chain -->
            <disable_collisions link1="${prefix}link7" link2="${prefix}wrist-sensor.base_link"
                reason="Adjacent" />
            <disable_collisions link1="${prefix}wrist-sensor.base_link"
                link2="${prefix}wrist-sensor.proximal_link" reason="Adjacent" />
            <disable_collisions link1="${prefix}wrist-sensor.proximal_link"
                link2="${prefix}wrist-sensor.distal_link" reason="Adjacent" />
            <disable_collisions link1="${prefix}wrist-sensor.distal_link" link2="${prefix}flange"
                reason="Adjacent" />
            <disable_collisions link1="${prefix}link7" link2="${prefix}wrist-sensor.proximal_link"
                reason="Adjacent" />
            <disable_collisions link1="${prefix}link7" link2="${prefix}wrist-sensor.distal_link"
                reason="Adjacent" />
        </xacro:if>
    </xacro:macro>
</robot>
