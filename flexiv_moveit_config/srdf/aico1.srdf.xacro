<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="aico1">
    <!-- parameters -->
    <xacro:arg name="platform_type" default="X1" />
    <xacro:arg name="platform_prefix" default="" />
    <xacro:arg name="arm_prefix" default="" />
    <xacro:arg name="robot_sn" default="" />
    <xacro:arg name="load_gripper" default="false" />
    <xacro:arg name="load_mounted_ft_sensor" default="false" />

    <xacro:include filename="$(find flexiv_moveit_config)/srdf/rizon_macro.srdf.xacro" />

    <!-- Arm -->
    <xacro:rizon_srdf arm_prefix="$(arg arm_prefix)" robot_sn="$(arg robot_sn)"
        load_mounted_ft_sensor="$(arg load_mounted_ft_sensor)" use_virtual_joint="false" />

    <!-- Prefixes -->
    <xacro:property name="prefix" value="${arm_prefix + robot_sn + '_'}" />
    <xacro:property name="platform_prefix" value="$(arg platform_prefix)" />

    <!-- Virtual Joint and Platform Group -->
    <xacro:if value="${'$(arg platform_type)' == 'X1'}">
        <virtual_joint name="virtual_joint" type="fixed" parent_frame="world"
            child_link="${platform_prefix}aico1_x1_base_link" />
        <group name="aico1_x1_platform">
            <chain base_link="${platform_prefix}aico1_x1_base_link" tip_link="${prefix}base_link" />
    </xacro:if>
    <xacro:if value="${'$(arg platform_type)' == 'X2'}">
        <virtual_joint name="virtual_joint" type="fixed" parent_frame="world"
            child_link="${platform_prefix}aico1_x2_agv" />
        <group name="aico1_x2_platform">
            <chain base_link="${platform_prefix}aico1_x2_base_link" tip_link="${prefix}base_link" />
    </xacro:if>

    <!-- Platform Collisions -->
    <xacro:if value="${'$(arg platform_type)' == 'X1'}">
        <disable_collisions link1="${prefix}base_link" link2="${platform_prefix}aico1_x1_link2" reason="Adjacent" />
        <disable_collisions link1="${prefix}base_link" link2="${platform_prefix}aico1_x1_link1" reason="Never" />
        <disable_collisions link1="${prefix}base_link" link2="${platform_prefix}aico1_x1_base_link" reason="Never" />
        <disable_collisions link1="${prefix}link1" link2="${platform_prefix}aico1_x1_link2" reason="Never" />
        <disable_collisions link1="${prefix}link1" link2="${platform_prefix}aico1_x1_link1" reason="Never" />
        <disable_collisions link1="${prefix}link1" link2="${platform_prefix}aico1_x1_base_link" reason="Never" />
        <disable_collisions link1="${platform_prefix}aico1_x1_base_link" link2="${platform_prefix}aico1_x1_link1" reason="Adjacent" />
        <disable_collisions link1="${platform_prefix}aico1_x1_base_link" link2="${platform_prefix}aico1_x1_link2" reason="Never" />
        <disable_collisions link1="${platform_prefix}aico1_x1_link1" link2="${platform_prefix}aico1_x1_link2" reason="Adjacent" />
    </xacro:if>

    <xacro:if value="${'$(arg platform_type)' == 'X2'}">
        <disable_collisions link1="${prefix}base_link" link2="${platform_prefix}aico1_x2_link1" reason="Adjacent" />
        <disable_collisions link1="${prefix}base_link" link2="${platform_prefix}aico1_x2_base_link" reason="Never" />
        <disable_collisions link1="${prefix}base_link" link2="${platform_prefix}aico1_x2_neck_link" reason="Never" />
        <disable_collisions link1="${prefix}base_link" link2="${platform_prefix}aico1_x2_head_link" reason="Never" />

        <disable_collisions link1="${prefix}link1" link2="${platform_prefix}aico1_x2_link1" reason="Never" />
        <disable_collisions link1="${prefix}link1" link2="${platform_prefix}aico1_x2_base_link" reason="Never" />
        <disable_collisions link1="${prefix}link1" link2="${platform_prefix}aico1_x2_neck_link" reason="Never" />
        <disable_collisions link1="${prefix}link1" link2="${platform_prefix}aico1_x2_head_link" reason="Never" />

        <disable_collisions link1="${platform_prefix}aico1_x2_base_link" link2="${platform_prefix}aico1_x2_link1" reason="Adjacent" />
        <disable_collisions link1="${platform_prefix}aico1_x2_base_link" link2="${platform_prefix}aico1_x2_neck_link" reason="Never" />
        <disable_collisions link1="${platform_prefix}aico1_x2_link1" link2="${platform_prefix}aico1_x2_neck_link" reason="Adjacent" />
        <disable_collisions link1="${platform_prefix}aico1_x2_neck_link" link2="${platform_prefix}aico1_x2_head_link" reason="Adjacent" />
    </xacro:if>

    <!-- Load gripper -->
    <xacro:if value="$(arg load_gripper)">
        <xacro:include filename="$(find flexiv_moveit_config)/srdf/grav.srdf.xacro" />
        <xacro:grav_srdf arm_prefix="$(arg arm_prefix)" robot_sn="$(arg robot_sn)"
            load_mounted_ft_sensor="$(arg load_mounted_ft_sensor)" />
    </xacro:if>

</robot>
