<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="rizon_grav_srdf" params="name prefix">
        <group name="${prefix}${name}_manipulator">
            <chain base_link="${prefix}base_link" tip_link="${prefix}closed_fingers_tcp" />
        </group>

        <group_state name="${prefix}home" group="${prefix}${name}_manipulator">
            <joint name="${prefix}joint1" value="0"/>
            <joint name="${prefix}joint2" value="${-2*pi/9}"/>
            <joint name="${prefix}joint3" value="0"/>
            <joint name="${prefix}joint4" value="${pi/2}"/>
            <joint name="${prefix}joint5" value="0"/>
            <joint name="${prefix}joint6" value="${2*pi/9}"/>
            <joint name="${prefix}joint7" value="0"/>
            <joint name="${prefix}finger_width_joint" value="0.0" />
        </group_state>

        <group_state name="open" group="${prefix}grav_gripper">
            <joint name="${prefix}finger_width_joint" value="0.1" />
        </group_state>

        <group_state name="closed" group="${prefix}grav_gripper">
            <joint name="${prefix}finger_width_joint" value="0.0" />
        </group_state>

        <end_effector name="${prefix}grav_gripper_tcp" parent_link="${prefix}closed_fingers_tcp" group="${prefix}grav_gripper" parent_group="${prefix}${name}_manipulator"/>
        <end_effector name="${prefix}grav_gripper" parent_link="${prefix}flange" group="${prefix}grav_gripper" parent_group="${prefix}${name}_arm"/>

        <disable_collisions link1="${prefix}grav_base_link" link2="${prefix}link7" reason="Adjacent" />
        <disable_collisions link1="${prefix}grav_base_link" link2="${prefix}flange" reason="Adjacent" />
        <disable_collisions link1="${prefix}closed_fingers_tcp" link2="${prefix}link7" reason="Adjacent" />
        <disable_collisions link1="${prefix}closed_fingers_tcp" link2="${prefix}flange" reason="Adjacent" />

    </xacro:macro>
</robot>
