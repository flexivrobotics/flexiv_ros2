# Set impedance properties of the robot's joint motion controller. Requires the driver to run with
# rdk_control_mode:=joint_impedance.
#
# An invalid request is rejected as a whole and nothing changes.

# Joints to set, named exactly as published on ~/joint_impedance. Leave empty to address every
# joint the interface covers, in that published order. On a dual-arm robot this is how a single
# arm is set on its own: name that arm's joints and the other arm is left untouched.
string[] joint_names

# Joint motion stiffness K_q, one entry per joint in joint_names, or one per covered joint when
# joint_names is empty. Valid range [0, k_q_nom]. Setting a joint to 0 makes it free-floating,
# which in this position-streaming driver means the joint will sag under gravity. [Nm/rad]
float64[] k_q

# Joint motion damping ratio Z_q, matching k_q entry for entry, or empty for the nominal 0.7.
# Valid range [0.3, 0.8]. Values away from nominal may lead to performance and stability issues.
float64[] z_q
---
bool success

# Operator-facing explanation of the outcome, naming the joint and the bound on a rejection
string message

# Every joint the interface covers and the values now held for it, unchanged from before on a
# rejection. Joints the request did not name keep the value they already had.
JointImpedance setting
