# Recover the robot from a fault back to an operational state.
# On success the robot is servoed on, operational and in IDLE control mode. Restoring the control
# mode is deliberately left to a controller restart, which re-initializes the controller's own
# setpoint and so cannot apply a stale pre-fault command.
#
# A robot in recovery state after a joint position limit violation is refused: use Flexiv Elements
# to get it out of that state.
---
bool success

# Operator-facing explanation of the outcome
string message

# True when the robot is operational again but controllers must be restarted to resume motion
bool requires_controller_restart

# Policy that applied to the condition found, values defined in RecoveryPolicy.msg
uint8 recovery_policy
---
# Current step of the recovery sequence
uint8 STATE_IDLE               = 0
uint8 STATE_CLASSIFY           = 1
uint8 STATE_STOP               = 2
uint8 STATE_CLEAR_FAULT        = 3
uint8 STATE_WAIT_FAULT_CLEARED = 4
uint8 STATE_SERVO_ON           = 5
uint8 STATE_WAIT_OPERATIONAL   = 6
uint8 STATE_COMPLETE           = 7
uint8 STATE_FAILED             = 8

uint8 recovery_state

# Human-readable name of the recovery state above
string recovery_state_name

# Seconds elapsed since the recovery started
float32 elapsed_seconds
